# Required for API startup and Prisma
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"

# Optional server settings
JWT_EXPIRES_IN="7d"
JWT_COOKIE_MAX_AGE_MS=604800000
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5173"

# SMTP placeholders; configure with your own provider to enable email delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="replace-with-your-smtp-password"
MAIL_FROM="Astraeon <noreply@example.com>"

# Set locally before creating the demo owner account with the seed script
DEMO_SEED_PASSWORD="set-a-local-password-of-at-least-12-characters"
